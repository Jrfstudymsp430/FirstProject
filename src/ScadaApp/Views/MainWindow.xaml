<Window
    x:Class="ScadaApp.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:ScadaApp.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vm="clr-namespace:ScadaApp.ViewModels"
    Title="SCADA · Modbus RTU 多通道采集系统"
    Width="1120"
    Height="700"
    MinWidth="900"
    MinHeight="560"
    Background="{StaticResource BgDark}"
    Closing="Window_Closing"
    Icon="pack://application:,,,/Assets/app.ico"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border
        Background="{StaticResource WindowBackgroundBrush}"
        BorderBrush="{StaticResource BorderColor}"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  深色标题栏  -->
            <Grid
                Grid.Row="0"
                Background="{StaticResource BgPanel}"
                ClipToBounds="True">
                <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
                <Border
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    IsHitTestVisible="False" />
                <StackPanel
                    Margin="12,0,140,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Orientation="Horizontal">
                    <Border
                        Width="14"
                        Height="14"
                        Margin="0,0,8,0"
                        CornerRadius="3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#00D4AA" />
                                <GradientStop Offset="1" Color="#00B4D8" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource TextSecondary}"
                        Text="SCADA · Modbus RTU 多通道采集系统" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Orientation="Horizontal">
                    <Button
                        x:Name="MinimizeButton"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource WindowChromeButton}"
                        ToolTip="最小化">
                        <Path Data="M0,5 H10" Style="{StaticResource WindowChromeIcon}" />
                    </Button>
                    <Button
                        x:Name="MaximizeButton"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeButton_Click"
                        Style="{StaticResource WindowChromeButton}"
                        ToolTip="最大化">
                        <Path
                            x:Name="MaximizeIcon"
                            Data="M1,1 H9 V9 H1 Z"
                            Style="{StaticResource WindowChromeIcon}" />
                    </Button>
                    <Button
                        x:Name="CloseButton"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click"
                        Style="{StaticResource WindowCloseButton}"
                        ToolTip="关闭">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Style="{StaticResource WindowChromeIcon}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!--  背景装饰  -->
                <Canvas IsHitTestVisible="False" Opacity="0.06">
                    <Ellipse
                        Canvas.Top="-80"
                        Canvas.Right="-120"
                        Width="400"
                        Height="400"
                        Fill="{StaticResource Accent}" />
                    <Ellipse
                        Canvas.Left="-100"
                        Canvas.Bottom="-100"
                        Width="350"
                        Height="350"
                        Fill="{StaticResource AccentBlue}" />
                </Canvas>

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  顶部工具栏  -->
                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        Padding="16,12"
                        Background="{StaticResource HeaderGradientBrush}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <DockPanel LastChildFill="True">
                            <StackPanel
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Orientation="Horizontal">
                                <Border
                                    Width="36"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Offset="0" Color="#00D4AA" />
                                            <GradientStop Offset="1" Color="#00B4D8" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Text="⚡" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextPrimary}"
                                        Text="SCADA 采集系统" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="Modbus RTU" />
                                </StackPanel>
                            </StackPanel>

                            <WrapPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right">
                                <Button
                                    Margin="0,0,6,0"
                                    Padding="12,6"
                                    Command="{Binding RefreshPortsCommand}"
                                    Content="刷新串口"
                                    Style="{StaticResource SecondaryButton}" />
                                <Button
                                    Margin="0,0,6,0"
                                    Padding="12,6"
                                    Command="{Binding SaveConfigCommand}"
                                    Content="保存"
                                    Style="{StaticResource SecondaryButton}" />
                                <Button
                                    Margin="0,0,6,0"
                                    Padding="12,6"
                                    Command="{Binding StartAllCommand}"
                                    Content="启动全部"
                                    Style="{StaticResource SuccessButton}" />
                                <Button
                                    Padding="12,6"
                                    Command="{Binding StopAllCommand}"
                                    Content="停止全部"
                                    Style="{StaticResource DangerButton}" />
                            </WrapPanel>

                            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border
                                    MinWidth="72"
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="通道" />
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource Accent}"
                                            Text="{Binding ChannelCount}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    MinWidth="72"
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="在线" />
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#00D4AA"
                                            Text="{Binding RunningChannelCount}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    MinWidth="72"
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="数据点" />
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource AccentBlue}"
                                            Text="{Binding TagCount}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    MinWidth="72"
                                    Padding="10,6"
                                    Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="正常" />
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#00D4AA"
                                            Text="{Binding GoodTagCount}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!--  分隔线  -->
                    <Border
                        Grid.Row="1"
                        Height="1"
                        Margin="0,0,0,12"
                        Background="{StaticResource BorderColor}"
                        Opacity="0.5" />

                    <!--  主内容区  -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="240" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="8*" MinWidth="520" />
                        </Grid.ColumnDefinitions>

                        <!--  左侧：通道列表  -->
                        <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                            <DockPanel>
                                <Grid Margin="0,0,0,14" DockPanel.Dock="Top">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionTitle}"
                                        Text="通信通道" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,6,0"
                                            Command="{Binding AddChannelCommand}"
                                            Content="+"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="添加通道" />
                                        <Button
                                            Command="{Binding RemoveChannelCommand}"
                                            Content="−"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="删除通道" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,14,0,0" DockPanel.Dock="Bottom">
                                    <Button
                                        Margin="0,0,0,8"
                                        Command="{Binding EditChannelCommand}"
                                        Content="通道参数"
                                        Style="{StaticResource SecondaryButton}" />
                                    <Button
                                        Margin="0,0,0,8"
                                        Command="{Binding StartChannelCommand}"
                                        Content="启动通道"
                                        Style="{StaticResource SuccessButton}" />
                                    <Button
                                        Command="{Binding StopChannelCommand}"
                                        Content="停止通道"
                                        Style="{StaticResource SecondaryButton}" />
                                </StackPanel>

                                <ListBox
                                    ItemContainerStyle="{StaticResource ChannelListItem}"
                                    ItemsSource="{Binding Channels}"
                                    SelectedItem="{Binding SelectedChannel}"
                                    Style="{StaticResource ChannelListBox}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse
                                                            Width="8"
                                                            Height="8"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Fill="{Binding State, Converter={StaticResource ChannelStateToBrush}}">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect
                                                                    BlurRadius="6"
                                                                    Opacity="0.8"
                                                                    ShadowDepth="0"
                                                                    Color="#00D4AA" />
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="Green"
                                                            Text="{Binding Config.Name}" />
                                                    </StackPanel>
                                                    <Border
                                                        Padding="6,2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding State, Converter={StaticResource ChannelStateToBadgeBrush}}"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{Binding State, Converter={StaticResource ChannelStateToBrush}}"
                                                            Text="{Binding State, Converter={StaticResource ChannelStateToLabel}}" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel Margin="16,6,0,0">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextSecondary}"
                                                        Text="{Binding Summary}" />
                                                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{StaticResource TextSecondary}"
                                                            Text="发 " />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{StaticResource Accent}"
                                                            Text="{Binding TxCount}" />
                                                        <TextBlock
                                                            Margin="10,0,0,0"
                                                            FontSize="11"
                                                            Foreground="{StaticResource TextSecondary}"
                                                            Text="收 " />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{StaticResource AccentBlue}"
                                                            Text="{Binding RxCount}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!--  右侧：实时监视（上）+ 点表配置（下）  -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.6*" MinHeight="200" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="0.8*" MinHeight="150" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource PanelCard}">
                                <DockPanel>
                                    <StackPanel
                                        Margin="0,0,0,12"
                                        DockPanel.Dock="Top"
                                        Orientation="Horizontal">
                                        <Border
                                            Width="3"
                                            Height="16"
                                            Margin="0,0,10,0"
                                            Background="{StaticResource AccentBarBrush}"
                                            CornerRadius="2" />
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="实时监视" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="{Binding SelectedChannel.Config.Name}" />
                                        <Border
                                            Margin="12,0,0,0"
                                            Padding="8,3"
                                            Background="#2200B4D8"
                                            CornerRadius="10">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource AccentBlue}"
                                                Text="{Binding TagCount, StringFormat={}{0} 点}" />
                                        </Border>
                                    </StackPanel>
                                    <Grid>
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource DataMonitorCard}">
                                                            <DockPanel>
                                                                <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                                                                    <TextBlock
                                                                        Margin="0,0,110,0"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{StaticResource TextPrimary}"
                                                                        Text="{Binding Name}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                                        <Button
                                                                            Margin="0,0,6,0"
                                                                            Padding="8,2"
                                                                            Command="{Binding DataContext.ShowTagTrendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="曲线"
                                                                            FontSize="11"
                                                                            Style="{StaticResource TableWriteButton}" />
                                                                        <Button
                                                                            Padding="8,2"
                                                                            Command="{Binding DataContext.WriteTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="写入"
                                                                            FontSize="11"
                                                                            Style="{StaticResource TableWriteButton}"
                                                                            Visibility="{Binding IsWritable, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                                                                    <Ellipse
                                                                        Width="8"
                                                                        Height="8"
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center"
                                                                        Fill="{Binding Quality, Converter={StaticResource QualityToBrush}}" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="11"
                                                                        Foreground="{StaticResource TextSecondary}"
                                                                        Text="{Binding Quality}" />
                                                                    <TextBlock
                                                                        Margin="10,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="11"
                                                                        Foreground="{StaticResource TextSecondary}"
                                                                        Text="{Binding Timestamp, Converter={StaticResource TimestampToText}}" />
                                                                </StackPanel>
                                                                <ctrl:TrendChart
                                                                    Height="46"
                                                                    Margin="0,4,0,8"
                                                                    Buffer="{Binding Trend}"
                                                                    ClickCommand="{Binding DataContext.ShowTagTrendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    ClickCommandParameter="{Binding}"
                                                                    Compact="True"
                                                                    Cursor="Hand"
                                                                    DockPanel.Dock="Bottom"
                                                                    LineBrush="{StaticResource Accent}"
                                                                    ToolTip="点击查看曲线" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                                                    FontSize="22"
                                                                    FontWeight="Bold"
                                                                    Foreground="{StaticResource Accent}"
                                                                    Text="{Binding DisplayValue}" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="暂无实时数据，请在下方点表配置中添加标签">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <GridSplitter
                                Grid.Row="1"
                                Height="8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                Cursor="SizeNS"
                                ResizeDirection="Rows"
                                ShowsPreview="False" />

                            <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                                <DockPanel>
                                    <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <Border
                                                Width="3"
                                                Height="16"
                                                Margin="0,0,10,0"
                                                Background="{StaticResource AccentBarBrush}"
                                                CornerRadius="2" />
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="点表配置" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button
                                                Margin="0,0,8,0"
                                                Command="{Binding WriteTagsBatchCommand}"
                                                Content="批量写入"
                                                Style="{StaticResource SecondaryButton}" />
                                            <Button
                                                Command="{Binding AddTagCommand}"
                                                Content="＋ 添加标签"
                                                Style="{StaticResource SecondaryButton}" />
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid
                                        x:Name="TagGrid"
                                        HorizontalAlignment="Stretch"
                                        ColumnWidth="*"
                                        HorizontalScrollBarVisibility="Disabled"
                                        ItemsSource="{Binding Tags}"
                                        RowHeaderWidth="0"
                                        SelectionChanged="TagGrid_SelectionChanged"
                                        SelectionMode="Extended"
                                        SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="1.2*"
                                                MinWidth="70"
                                                Binding="{Binding Name}"
                                                Header="名称">
                                                <DataGridTextColumn.HeaderStyle>
                                                    <Style BasedOn="{StaticResource DataGridHeaderLeft}" TargetType="DataGridColumnHeader" />
                                                </DataGridTextColumn.HeaderStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style BasedOn="{StaticResource DataGridCellLeft}" TargetType="TextBlock" />
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn
                                                Width="1.6*"
                                                MinWidth="110"
                                                Binding="{Binding FunctionCode}"
                                                Header="功能码">
                                                <DataGridTextColumn.HeaderStyle>
                                                    <Style BasedOn="{StaticResource DataGridHeaderLeft}" TargetType="DataGridColumnHeader" />
                                                </DataGridTextColumn.HeaderStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style BasedOn="{StaticResource DataGridCellLeft}" TargetType="TextBlock" />
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn
                                                Width="0.7*"
                                                MinWidth="48"
                                                Binding="{Binding Address}"
                                                Header="地址">
                                                <DataGridTextColumn.HeaderStyle>
                                                    <Style BasedOn="{StaticResource DataGridHeaderCenter}" TargetType="DataGridColumnHeader" />
                                                </DataGridTextColumn.HeaderStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style BasedOn="{StaticResource DataGridCellCenter}" TargetType="TextBlock" />
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn
                                                Width="1.1*"
                                                MinWidth="80"
                                                Binding="{Binding DataType}"
                                                Header="类型">
                                                <DataGridTextColumn.HeaderStyle>
                                                    <Style BasedOn="{StaticResource DataGridHeaderCenter}" TargetType="DataGridColumnHeader" />
                                                </DataGridTextColumn.HeaderStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style BasedOn="{StaticResource DataGridCellCenter}" TargetType="TextBlock" />
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn
                                                Width="2.2*"
                                                MinWidth="210"
                                                Header="操作">
                                                <DataGridTemplateColumn.HeaderStyle>
                                                    <Style BasedOn="{StaticResource DataGridHeaderCenter}" TargetType="DataGridColumnHeader" />
                                                </DataGridTemplateColumn.HeaderStyle>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <Button
                                                                Margin="0,0,6,0"
                                                                Command="{Binding DataContext.WriteTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="写入"
                                                                Style="{StaticResource TableWriteButton}" />
                                                            <Button
                                                                Margin="0,0,6,0"
                                                                Command="{Binding DataContext.ShowTagTrendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="曲线"
                                                                Style="{StaticResource TableWriteButton}" />
                                                            <Button
                                                                Margin="0,0,6,0"
                                                                Command="{Binding DataContext.EditTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="编辑"
                                                                Style="{StaticResource TableActionButton}" />
                                                            <Button
                                                                Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="删除"
                                                                Style="{StaticResource TableDangerButton}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!--  通信日志  -->
                    <Border
                        Grid.Row="3"
                        Margin="0,12,0,12"
                        Padding="14,12"
                        Style="{StaticResource PanelCard}">
                        <DockPanel>
                            <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Width="3"
                                        Height="14"
                                        Margin="0,0,10,0"
                                        Background="{StaticResource AccentBarBrush}"
                                        CornerRadius="2" />
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="通信日志" />
                                    <Border
                                        Margin="12,0,0,0"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="{Binding SelectedChannel.State, Converter={StaticResource ChannelStateToBadgeBrush}}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{Binding SelectedChannel.State, Converter={StaticResource ChannelStateToBrush}}"
                                            Text="{Binding ConnectionStatusText}" />
                                    </Border>
                                </StackPanel>
                                <Button
                                    Padding="10,4"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ClearLogsCommand}"
                                    Content="清空日志"
                                    Style="{StaticResource SecondaryButton}" />
                            </Grid>
                            <ListBox
                                ItemContainerStyle="{StaticResource LogListItem}"
                                ItemsSource="{Binding Logs}"
                                Style="{StaticResource LogListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Foreground="{StaticResource TextSecondary}"
                                                Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                                Text="{Binding Level}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Foreground="{StaticResource AccentBlue}"
                                                Text="{Binding ChannelName}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Foreground="{StaticResource TextPrimary}"
                                                Text="{Binding Message}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!--  状态栏  -->
                    <Border
                        Grid.Row="4"
                        Padding="14,8"
                        Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="0,0,8,0"
                                    Fill="{StaticResource Accent}" />
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="{Binding StatusText}" />
                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,14,0"
                                    FontSize="11"
                                    Foreground="{StaticResource Accent}"
                                    Text="{Binding SelectedChannel.PacketStats}" />
                                <TextBlock
                                    Margin="0,0,14,0"
                                    FontSize="11"
                                    Foreground="{StaticResource Accent}"
                                    Text="{Binding ConnectionStatusText}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="{Binding CurrentTime, StringFormat=Modbus RTU · {0}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
