<Window x:Class="ScadaApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScadaApp.ViewModels"
        Title="SCADA - Modbus RTU 多通道采集系统"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="SCADA" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="Modbus RTU 多通道" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="刷新串口" Command="{Binding RefreshPortsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="保存配置" Command="{Binding SaveConfigCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="启动全部" Command="{Binding StartAllCommand}" Margin="0,0,8,0"/>
                    <Button Content="停止全部" Command="{Binding StopAllCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 通道列表 -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="6" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="通信通道" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="+" Width="32" Padding="0" Margin="8,0,0,0" Command="{Binding AddChannelCommand}"/>
                        <Button Content="-" Width="32" Padding="0" Margin="4,0,0,0"
                                Style="{StaticResource DangerButton}" Command="{Binding RemoveChannelCommand}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="启动通道" Command="{Binding StartChannelCommand}" Margin="0,0,0,6"/>
                        <Button Content="停止通道" Command="{Binding StopChannelCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Channels}"
                             SelectedItem="{Binding SelectedChannel}"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                                 Fill="{Binding State, Converter={StaticResource ChannelStateToBrush}}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="18,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧：配置 + 实时数据 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 通道参数 -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                        DataContext="{Binding SelectedChannel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="通道名称" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <TextBox Text="{Binding Config.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="串口" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <ComboBox ItemsSource="{Binding DataContext.AvailablePorts, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding Config.PortName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="波特率" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <ComboBox ItemsSource="{Binding DataContext.BaudRates, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Config.BaudRate}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="轮询间隔(ms)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <TextBox Text="{Binding Config.PollingIntervalMs, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 标签数据表 -->
                <Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="6" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="实时数据点" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="添加标签" Margin="12,0,0,0" Command="{Binding AddTagCommand}"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Tags}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120"/>
                                <DataGridTextColumn Header="从站" Binding="{Binding SlaveId}" Width="50"/>
                                <DataGridTextColumn Header="功能码" Binding="{Binding FunctionCode}" Width="140"/>
                                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="60"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="70"/>
                                <DataGridTextColumn Header="当前值" Binding="{Binding DisplayValue}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="14"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="质量" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="12" Height="12"
                                                     Fill="{Binding Quality, Converter={StaticResource QualityToBrush}}"
                                                     HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="更新时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="100"/>
                                <DataGridTemplateColumn Header="操作" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="编辑" Padding="8,4" Margin="0,0,4,0" Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.EditTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="写入" Padding="8,4" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.WriteTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsWritable, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="删除" Padding="8,4" Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 日志 -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" CornerRadius="6" Padding="10" Margin="0,10,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="通信日志" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding Logs}" BorderThickness="0" FontFamily="Consolas" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{StaticResource BgCard}" CornerRadius="4" Padding="10,6">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}"/>
        </Border>
    </Grid>
</Window>
