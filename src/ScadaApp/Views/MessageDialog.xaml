<Window
    x:Class="ScadaApp.Views.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="360"
    Background="{StaticResource BgDark}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Border MouseLeftButtonDown="Header_MouseLeftButtonDown" Style="{StaticResource DialogRootBorder}">
        <StackPanel>
            <TextBlock
                x:Name="TitleText"
                Margin="0,0,0,10"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{StaticResource TextSecondary}" />
            <TextBlock
                x:Name="MessageText"
                MaxWidth="420"
                Margin="0,0,0,20"
                Foreground="{StaticResource TextSecondary}"
                TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="CancelButton"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
                <Button
                    x:Name="OkButton"
                    Width="90"
                    Click="OkButton_Click"
                    Content="确定"
                    IsDefault="True"
                    Style="{StaticResource SuccessButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
