<Window
    x:Class="ScadaApp.Views.TagTrendWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:ScadaApp.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="点位曲线"
    Width="860"
    Height="520"
    MinWidth="640"
    MinHeight="380"
    Background="{StaticResource BgDark}"
    Icon="pack://application:,,,/Assets/app.ico"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border
        Background="{StaticResource WindowBackgroundBrush}"
        BorderBrush="{StaticResource BorderColor}"
        BorderThickness="1">
        <DockPanel>
            <Grid
                Height="36"
                Background="{StaticResource BgPanel}"
                DockPanel.Dock="Top"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    IsHitTestVisible="False" />
                <StackPanel
                    Margin="12,0,90,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Orientation="Horizontal">
                    <Border
                        Width="3"
                        Height="14"
                        Margin="0,0,10,0"
                        Background="{StaticResource AccentBarBrush}"
                        CornerRadius="1" />
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        Text="点位曲线" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Click="MaximizeButton_Click"
                        Style="{StaticResource WindowChromeButton}"
                        ToolTip="最大化">
                        <Path
                            x:Name="MaximizeIcon"
                            Data="M1,1 H9 V9 H1 Z"
                            Style="{StaticResource WindowChromeIcon}" />
                    </Button>
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource WindowCloseButton}"
                        ToolTip="关闭">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Style="{StaticResource WindowChromeIcon}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border
                Margin="14"
                Padding="14"
                DockPanel.Dock="Top"
                Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <Border
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="当前" />
                                <TextBlock
                                    x:Name="CurrentText"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Accent}"
                                    Text="--" />
                            </StackPanel>
                        </Border>
                        <Border
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="最小" />
                                <TextBlock
                                    x:Name="MinText"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextPrimary}"
                                    Text="--" />
                            </StackPanel>
                        </Border>
                        <Border
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="最大" />
                                <TextBlock
                                    x:Name="MaxText"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextPrimary}"
                                    Text="--" />
                            </StackPanel>
                        </Border>
                        <Border
                            MinWidth="88"
                            Padding="10,6"
                            Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="平均" />
                                <TextBlock
                                    x:Name="AvgText"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextPrimary}"
                                    Text="--" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="Range1Button"
                            Margin="0,0,6,0"
                            Click="RangeButton_Click"
                            Content="1 分钟"
                            Tag="60"
                            Style="{StaticResource SecondaryButton}" />
                        <Button
                            x:Name="Range5Button"
                            Margin="0,0,6,0"
                            Click="RangeButton_Click"
                            Content="5 分钟"
                            Tag="300"
                            Style="{StaticResource SecondaryButton}" />
                        <Button
                            x:Name="Range15Button"
                            Margin="0,0,6,0"
                            Click="RangeButton_Click"
                            Content="15 分钟"
                            Tag="900"
                            Style="{StaticResource SecondaryButton}" />
                        <Button
                            x:Name="RangeAllButton"
                            Click="RangeButton_Click"
                            Content="全部"
                            Tag="0"
                            Style="{StaticResource SuccessButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Margin="14,0,14,14"
                Padding="8"
                Style="{StaticResource PanelCard}">
                <ctrl:TrendChart
                    x:Name="Chart"
                    LineBrush="{StaticResource Accent}"
                    WindowSeconds="0" />
            </Border>
        </DockPanel>
    </Border>
</Window>
