<Window
    x:Class="ScadaApp.Views.BatchWriteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="批量写入"
    Width="560"
    MinWidth="560"
    MaxHeight="620"
    Background="{StaticResource BgDark}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border
        Background="{StaticResource BgPanel}"
        BorderBrush="{StaticResource BorderColor}"
        BorderThickness="1">
        <DockPanel>
            <Border
                Height="40"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel
                        Margin="14,0,44,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Orientation="Horizontal">
                        <Border
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            Background="{StaticResource AccentBarBrush}"
                            CornerRadius="1" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimary}"
                            Text="批量写入" />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Right"
                        Click="CancelButton_Click"
                        IsCancel="True"
                        Style="{StaticResource WindowCloseButton}"
                        ToolTip="关闭">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Style="{StaticResource WindowChromeIcon}" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Margin="20,16,20,18">
                <TextBlock
                    x:Name="SummaryText"
                    Margin="0,0,0,10"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondary}"
                    Text="连续地址将用功能码 16 一次写入" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondary}"
                        Text="名称" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondary}"
                        Text="地址" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondary}"
                        Text="类型" />
                    <TextBlock
                        Grid.Column="3"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondary}"
                        Text="写入值" />
                </Grid>

                <ScrollViewer
                    MaxHeight="360"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RowList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimary}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                        FontSize="13"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="{Binding Address}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource Accent}"
                                        Text="{Binding DataType}" />
                                    <TextBox
                                        Grid.Column="3"
                                        Height="32"
                                        MinHeight="32"
                                        VerticalContentAlignment="Center"
                                        FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                        FontSize="14"
                                        Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                        TextAlignment="Left" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="11"
                    Foreground="{StaticResource TextSecondary}"
                    Text="Float 使用 CDAB 字序；多点合并为一次 16 写多寄存器" />

                <StackPanel
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="84"
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="0"
                        Click="CancelButton_Click"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}" />
                    <Button
                        Width="84"
                        Height="32"
                        Padding="0"
                        Click="OkButton_Click"
                        Content="写入"
                        IsDefault="True"
                        Style="{StaticResource SuccessButton}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
