<Window
    x:Class="ScadaApp.Views.ChannelConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="通道参数"
    Width="400"
    Background="{StaticResource BgDark}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border
        Background="{StaticResource BgPanel}"
        BorderBrush="{StaticResource BorderColor}"
        BorderThickness="1">
        <DockPanel>
            <Border
                Height="40"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel
                        Margin="14,0,44,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Orientation="Horizontal">
                        <Border
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            Background="{StaticResource AccentBarBrush}"
                            CornerRadius="1" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimary}"
                            Text="通道参数" />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Right"
                        Click="CancelButton_Click"
                        IsCancel="True"
                        Style="{StaticResource WindowCloseButton}"
                        ToolTip="关闭">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Style="{StaticResource WindowChromeIcon}" />
                    </Button>
                </Grid>
            </Border>
            <Grid Margin="22,18,22,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DialogFieldLabel}"
                    Text="通道名称" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Padding="3,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DialogFieldLabel}"
                    Text="串口" />
                <ComboBox
                    x:Name="PortCombo"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    IsEditable="True"
                    Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DialogFieldLabel}"
                    Text="波特率" />
                <ComboBox
                    x:Name="BaudCombo"
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    SelectedItem="{Binding BaudRate}" />

                <TextBlock
                    Grid.Row="3"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DialogFieldLabel}"
                    Text="从机ID" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Padding="3,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="4"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DialogFieldLabel}"
                    Text="轮询间隔(ms)" />
                <TextBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Padding="3,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding PollingIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel
                    Grid.Row="5"
                    Grid.ColumnSpan="2"
                    Margin="0,10,0,10"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="84"
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="0"
                        Click="CancelButton_Click"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}" />
                    <Button
                        Width="84"
                        Height="32"
                        Padding="0"
                        Click="OkButton_Click"
                        Content="确定"
                        IsDefault="True"
                        Style="{StaticResource SuccessButton}" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
