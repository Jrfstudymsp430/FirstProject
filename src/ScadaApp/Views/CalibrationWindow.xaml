<Window
    x:Class="ScadaApp.Views.CalibrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="{Binding Title}"
    Width="960"
    Height="680"
    MinWidth="860"
    MinHeight="560"
    Background="{StaticResource BgDark}"
    Icon="pack://application:,,,/Assets/app.ico"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border
        Background="{StaticResource WindowBackgroundBrush}"
        BorderBrush="{StaticResource BorderColor}"
        BorderThickness="1">
        <DockPanel>
            <Grid
                Height="36"
                Background="{StaticResource BgPanel}"
                DockPanel.Dock="Top"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    IsHitTestVisible="False" />
                <StackPanel
                    Margin="12,0,90,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Orientation="Horizontal">
                    <Border
                        Width="3"
                        Height="14"
                        Margin="0,0,10,0"
                        Background="{StaticResource AccentBarBrush}"
                        CornerRadius="1" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        Text="{Binding Title}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Click="MaximizeButton_Click"
                        Style="{StaticResource WindowChromeButton}"
                        ToolTip="最大化">
                        <Path
                            x:Name="MaximizeIcon"
                            Data="M1,1 H9 V9 H1 Z"
                            Style="{StaticResource WindowChromeIcon}" />
                    </Button>
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource WindowCloseButton}"
                        ToolTip="关闭">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Style="{StaticResource WindowChromeIcon}" />
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock
                Margin="16,0,16,12"
                DockPanel.Dock="Bottom"
                FontSize="12"
                Foreground="{StaticResource TextSecondary}"
                Text="{Binding StatusText}" />

            <Border
                Margin="14,12,14,8"
                Padding="14"
                DockPanel.Dock="Top"
                Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,18,8" Orientation="Horizontal">
                            <TextBlock
                                Width="64"
                                VerticalAlignment="Center"
                                Style="{StaticResource DialogFieldLabel}"
                                Text="实测点位" />
                            <ComboBox
                                Width="180"
                                VerticalAlignment="Center"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Tags}"
                                SelectedItem="{Binding SelectedTag}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,8" Orientation="Horizontal">
                            <TextBlock
                                Width="64"
                                VerticalAlignment="Center"
                                Style="{StaticResource DialogFieldLabel}"
                                Text="近期点数" />
                            <ComboBox
                                Width="80"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding SampleCounts}"
                                SelectedItem="{Binding SampleCount}" />
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Grid.Row="1" Margin="0,4,0,0">
                        <Border
                            MinWidth="110"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="当前采集" />
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Accent}"
                                    Text="{Binding CurrentValueText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            MinWidth="110"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="近期均值" />
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextPrimary}"
                                    Text="{Binding AverageText}" />
                            </StackPanel>
                        </Border>
                        <Border
                            MinWidth="140"
                            Padding="10,6"
                            Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="样本" />
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimary}"
                                    Text="{Binding SampleHint}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border
                Margin="14,0,14,8"
                Padding="14"
                DockPanel.Dock="Top"
                Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource DialogFieldLabel}"
                        Text="标准值" />
                    <TextBox
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        Padding="3,0,0,0"
                        VerticalAlignment="Center"
                        KeyDown="StandardInput_KeyDown"
                        Text="{Binding StandardInput, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="2"
                        Width="110"
                        Height="32"
                        Command="{Binding AddPointCommand}"
                        Content="添加标定点"
                        Style="{StaticResource SuccessButton}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondary}"
                        Text="工况稳定后填入标准值，与左侧近期数据的平均值组成一组标定点。"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border
                Margin="14,0,14,8"
                Padding="14"
                DockPanel.Dock="Bottom"
                Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource DialogFieldLabel}"
                            Text="起始地址" />
                        <TextBox
                            Grid.Column="1"
                            Margin="8,0,12,0"
                            Padding="3,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding StartAddressText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource DialogFieldLabel}"
                            Text="写入类型" />
                        <ComboBox
                            Grid.Column="3"
                            Margin="8,0,12,0" 
                            VerticalAlignment="Center"
                            ItemsSource="{Binding DownloadTypes}"
                            SelectedItem="{Binding DownloadDataType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource DataTypeToText}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource DialogFieldLabel}"
                            Text="下载内容" />
                        <ComboBox
                            Grid.Column="5"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding WriteModes}"
                            SelectedValue="{Binding WriteMode}"
                            SelectedValuePath="Mode" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondary}"
                                Text="{Binding FitHint}" />
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondary}"
                                Text="k =" />
                            <TextBlock
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimary}"
                                Text="{Binding SlopeText}" />
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondary}"
                                Text="b =" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimary}"
                                Text="{Binding InterceptText}" />
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Width="84"
                                Height="32"
                                Margin="0,0,8,0"
                                Command="{Binding ClearPointsCommand}"
                                Content="清空"
                                Style="{StaticResource SecondaryButton}" />
                            <Button
                                Width="110"
                                Height="32"
                                Command="{Binding DownloadCommand}"
                                Content="下载到下位机"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"
                                Style="{StaticResource SuccessButton}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="14,0,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="8"
                    Style="{StaticResource PanelCard}">
                    <DockPanel>
                        <Grid Margin="6,2,6,8" DockPanel.Dock="Top">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionTitle}"
                                Text="近期采集" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondary}"
                                Text="{Binding SampleHint}" />
                        </Grid>
                        <DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding RecentSamples}"
                            RowHeight="32"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="52"
                                    Binding="{Binding Ordinal}"
                                    Header="序号">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource DataGridHeaderCenter}" TargetType="DataGridColumnHeader" />
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource DataGridCellCenter}" TargetType="TextBlock" />
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding TimeText}"
                                    Header="时间">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource DataGridHeaderCenter}" TargetType="DataGridColumnHeader" />
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource DataGridCellCenter}" TargetType="TextBlock" />
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding ValueText}"
                                    Header="采集值">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource DataGridHeaderCenter}" TargetType="DataGridColumnHeader" />
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource DataGridCellCenter}" TargetType="TextBlock" />
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="8"
                    Style="{StaticResource PanelCard}">
                    <DockPanel>
                        <TextBlock
                            Margin="6,2,6,8"
                            DockPanel.Dock="Top"
                            Style="{StaticResource SectionTitle}"
                            Text="标定点" />
                        <DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Points}"
                            RowHeight="32"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="52"
                                    Binding="{Binding Ordinal}"
                                    Header="序号">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource DataGridHeaderCenter}" TargetType="DataGridColumnHeader" />
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource DataGridCellCenter}" TargetType="TextBlock" />
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding MeasuredText}"
                                    Header="实测均值">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource DataGridHeaderCenter}" TargetType="DataGridColumnHeader" />
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource DataGridCellCenter}" TargetType="TextBlock" />
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding StandardText}"
                                    Header="标准值">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource DataGridHeaderCenter}" TargetType="DataGridColumnHeader" />
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource DataGridCellCenter}" TargetType="TextBlock" />
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="80" Header="操作">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource DataGridHeaderCenter}" TargetType="DataGridColumnHeader" />
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                HorizontalAlignment="Center"
                                                Command="{Binding DataContext.RemovePointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="删除"
                                                Style="{StaticResource TableDangerButton}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
