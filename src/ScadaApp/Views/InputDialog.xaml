<Window x:Class="ScadaApp.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinWidth="400"
        WindowStyle="None"
        Background="{StaticResource BgDark}"
        ShowInTaskbar="False">
    <Border Style="{StaticResource DialogRootBorder}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentGradientBrush}" Margin="0,0,12,0">
                    <TextBlock Text="✎" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="PromptText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
            <TextBox x:Name="InputTextBox" MinWidth="320" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="90" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Click="CancelButton_Click" IsCancel="True"/>
                <Button Content="确定" Width="90" Style="{StaticResource SuccessButton}"
                        Click="OkButton_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
