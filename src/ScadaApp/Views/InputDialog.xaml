<Window
    x:Class="ScadaApp.Views.InputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="写入数据"
    Width="380"
    Background="{StaticResource BgDark}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border
        Background="{StaticResource BgPanel}"
        BorderBrush="{StaticResource BorderColor}"
        BorderThickness="1">
        <DockPanel>
            <!--  标题栏  -->
            <Border
                Height="40"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel
                        Margin="14,0,44,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Orientation="Horizontal">
                        <Border
                            Width="3"
                            Height="14"
                            Margin="0,0,10,0"
                            Background="{StaticResource AccentBarBrush}"
                            CornerRadius="1" />
                        <TextBlock
                            x:Name="TitleText"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimary}"
                            Text="写入数据" />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Right"
                        Click="CancelButton_Click"
                        IsCancel="True"
                        Style="{StaticResource WindowCloseButton}"
                        ToolTip="关闭">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Style="{StaticResource WindowChromeIcon}" />
                    </Button>
                </Grid>
            </Border>

            <!--  内容  -->
            <StackPanel Margin="20,16,20,18">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,0,8"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondary}"
                        Text="数据点" />
                    <TextBlock
                        x:Name="PointNameText"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        Text="—" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondary}"
                        Text="类型" />
                    <TextBlock
                        x:Name="DataTypeText"
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource Accent}"
                        Text="Float CDAB" />
                </Grid>

                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondary}"
                    Text="写入值" />
                <TextBox
                    x:Name="InputTextBox"
                    Height="36"
                    MinHeight="36"
                    FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                    FontSize="16"
                    TextAlignment="Left" />
                <TextBlock
                    x:Name="HintText"
                    Margin="0,8,0,0"
                    FontSize="11"
                    Foreground="{StaticResource TextSecondary}"
                    Text="写入保持寄存器；Float CDAB 两寄存器，Double GHEF CDAB 四寄存器" />

                <StackPanel
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="84"
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="0"
                        Click="CancelButton_Click"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}" />
                    <Button
                        Width="84"
                        Height="32"
                        Padding="0"
                        Click="OkButton_Click"
                        Content="写入"
                        IsDefault="True"
                        Style="{StaticResource SuccessButton}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
