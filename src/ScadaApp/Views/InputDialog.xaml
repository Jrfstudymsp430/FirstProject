<Window
    x:Class="ScadaApp.Views.InputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="400"ss
    Background="{StaticResource BgDark}"
    ShowInTaskbar="False">
    <Border MouseLeftButtonDown="Header_MouseLeftButtonDown" Style="{StaticResource DialogRootBorder}">
        <StackPanel>
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <Border
                    Width="36"
                    Height="36"
                    Margin="0,0,12,0"
                    Background="{StaticResource AccentGradientBrush}"
                    CornerRadius="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="✎" />
                </Border>
                <TextBlock
                    x:Name="PromptText"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{StaticResource TextSecondary}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBox
                x:Name="InputTextBox"
                MinWidth="320"
                Margin="0,0,0,20" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="90"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
                <Button
                    Width="90"
                    Click="OkButton_Click"
                    Content="确定"
                    IsDefault="True"
                    Style="{StaticResource SuccessButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
