<Window
    x:Class="ScadaApp.Views.TagConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="标签配置"
    MinWidth="460"
    Background="{StaticResource BgDark}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Border MouseLeftButtonDown="Header_MouseLeftButtonDown" Style="{StaticResource DialogRootBorder}">
        <StackPanel>
            <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                <Border
                    Width="36"
                    Height="36"
                    Margin="0,0,12,0"
                    Background="{StaticResource AccentGradientBrush}"
                    CornerRadius="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Text="⚙" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextSecondary}"
                        Text="标签配置" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource TextSecondary}"
                        Text="Modbus 数据点参数" />
                </StackPanel>
            </StackPanel>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource FieldLabel}"
                    Text="名称" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource FieldLabel}"
                    Text="从站地址" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource FieldLabel}"
                    Text="功能码" />
                <ComboBox
                    x:Name="FunctionCodeCombo"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    SelectedItem="{Binding FunctionCode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FunctionCodeToText}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource FieldLabel}"
                    Text="寄存器地址" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource FieldLabel}"
                    Text="数据类型" />
                <ComboBox
                    x:Name="DataTypeCombo"
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    SelectedItem="{Binding DataType}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource DataTypeToText}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource FieldLabel}"
                    Text="单位" />
                <TextBox
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource FieldLabel}"
                    Text="比例 / 偏移" />
                <StackPanel
                    Grid.Row="6"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    Orientation="Horizontal">
                    <TextBox
                        Width="90"
                        Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Scale" />
                    <TextBlock
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextSecondary}"
                        Text=" / " />
                    <TextBox
                        Width="90"
                        Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Offset" />
                </StackPanel>

                <TextBlock
                    Grid.Row="7"
                    Grid.Column="1"
                    Margin="0,0,0,20"
                    FontSize="11"
                    Foreground="{StaticResource TextSecondary}"
                    Text="03 只读采集；06 写单寄存器；16 写多寄存器（Float CDAB）" />
            </Grid>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="90"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
                <Button
                    Width="90"
                    Click="OkButton_Click"
                    Content="确定"
                    IsDefault="True"
                    Style="{StaticResource SuccessButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
