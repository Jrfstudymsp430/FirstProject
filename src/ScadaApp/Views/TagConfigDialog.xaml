<Window x:Class="ScadaApp.Views.TagConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标签配置"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinWidth="460"
        WindowStyle="None"
        Background="{StaticResource BgDark}"
        ShowInTaskbar="False">
    <Border Style="{StaticResource DialogRootBorder}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentGradientBrush}" Margin="0,0,12,0">
                    <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="标签配置" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Modbus 数据点参数" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="从站地址" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="功能码" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <ComboBox x:Name="FunctionCodeCombo" Grid.Row="2" Grid.Column="1"
                          SelectedItem="{Binding FunctionCode}" Margin="0,0,0,10">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FunctionCodeToText}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="寄存器地址" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="数据类型" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <ComboBox x:Name="DataTypeCombo" Grid.Row="4" Grid.Column="1"
                          SelectedItem="{Binding DataType}" Margin="0,0,0,10">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource DataTypeToText}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="单位" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="比例 / 偏移" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Width="90" Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" ToolTip="Scale"/>
                    <TextBlock Text=" / " VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="4,0"/>
                    <TextBox Width="90" Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" ToolTip="Offset"/>
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,0,0,20" FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           Text="03 只读采集；06 写单寄存器；16 写多寄存器（Float CDAB）"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="90" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Click="CancelButton_Click" IsCancel="True"/>
                <Button Content="确定" Width="90" Style="{StaticResource SuccessButton}"
                        Click="OkButton_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
